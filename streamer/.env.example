# Copy to .env and fill in. Never commit .env: the keys open the channels' clean outputs.
SITE=https://rashtrix.ilmazsyed.workers.dev
# The key= part of each output address (control room → TV channels).
KEY_H=
KEY_V=
# This machine's address (e.g. rashtrix.duckdns.org) and a long random secret for the HLS path.
DOMAIN=
FEED_SECRET=
# Picture size and bitrate. 720p is the safe start on the free machine; for 1080p set
# H_WIDTH=1920 H_HEIGHT=1080 H_BITRATE=4500k (and V_WIDTH=1080 V_HEIGHT=1920 V_BITRATE=4500k).
H_WIDTH=1280
H_HEIGHT=720
H_BITRATE=3000k
V_WIDTH=720
V_HEIGHT=1280
V_BITRATE=3000k
FPS=30
# Optional: also push to a platform's RTMP ingest (its server address + stream key, one line).
PUSH_H=
PUSH_V=
