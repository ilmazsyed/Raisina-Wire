/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
/api/*
  Cache-Control: no-store
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# The live studio: guests (and the producer's talkback) need the camera and microphone, here and
# in VDO.Ninja when a room uses it.
/guest.html
  ! Permissions-Policy
  Permissions-Policy: camera=(self "https://vdo.ninja"), microphone=(self "https://vdo.ninja"), display-capture=(self "https://vdo.ninja"), autoplay=*, fullscreen=*, geolocation=()
/guest
  ! Permissions-Policy
  Permissions-Policy: camera=(self "https://vdo.ninja"), microphone=(self "https://vdo.ninja"), display-capture=(self "https://vdo.ninja"), autoplay=*, fullscreen=*, geolocation=()
/studio.html
  ! Permissions-Policy
  Permissions-Policy: camera=(self "https://vdo.ninja"), microphone=(self "https://vdo.ninja"), autoplay=*, fullscreen=*, geolocation=()
/studio
  ! Permissions-Policy
  Permissions-Policy: camera=(self "https://vdo.ninja"), microphone=(self "https://vdo.ninja"), autoplay=*, fullscreen=*, geolocation=()
