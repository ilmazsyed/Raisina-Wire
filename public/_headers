/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
/api/*
  Cache-Control: no-store
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# The live studio: guests (and the producer's talkback) need the camera and microphone, here and
# in VDO.Ninja when a room uses it.
/guest.html
  ! Permissions-Policy
  Permissions-Policy: camera=(self "https://vdo.ninja"), microphone=(self "https://vdo.ninja"), display-capture=(self "https://vdo.ninja"), autoplay=*, fullscreen=*, geolocation=()
/guest
  ! Permissions-Policy
  Permissions-Policy: camera=(self "https://vdo.ninja"), microphone=(self "https://vdo.ninja"), display-capture=(self "https://vdo.ninja"), autoplay=*, fullscreen=*, geolocation=()
/studio.html
  ! Permissions-Policy
  Permissions-Policy: camera=(self "https://vdo.ninja"), microphone=(self "https://vdo.ninja"), autoplay=*, fullscreen=*, geolocation=()
/studio
  ! Permissions-Policy
  Permissions-Policy: camera=(self "https://vdo.ninja"), microphone=(self "https://vdo.ninja"), autoplay=*, fullscreen=*, geolocation=()
# The e-paper: framed by the site's own share card (src/ogcard.js), never by another site.
/epaper
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
/epaper.html
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
# The Explainer desk: lines are recorded here with the microphone.
/explainer.html
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), autoplay=*, fullscreen=*, geolocation=()
/explainer
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), autoplay=*, fullscreen=*, geolocation=()
# The AVO recorder: it records the screen (a story with a YouTube video) with its sound.
/avorec.html
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), display-capture=(self), autoplay=*, fullscreen=*, geolocation=()
/avorec
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), display-capture=(self), autoplay=*, fullscreen=*, geolocation=()
